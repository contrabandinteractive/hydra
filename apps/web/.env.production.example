# =============================================================================
# Hydra - Production Environment (LIVE/Mainnet)
# =============================================================================
# Use this configuration for mainnet deployment with official MNEE tokens

# WalletConnect
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# App URL (IMPORTANT for production!)
# Set this to your deployed app URL (e.g., https://hydra.yourdomain.com)
NEXT_PUBLIC_APP_URL=https://your-app-url.com

# Factory Addresses (Deploy to mainnet first!)
NEXT_PUBLIC_MAINNET_FACTORY_ADDRESS=0x_YOUR_DEPLOYED_FACTORY_ADDRESS
NEXT_PUBLIC_SEPOLIA_FACTORY_ADDRESS=

# MNEE Token Addresses (PRODUCTION MODE - using official MNEE)
NEXT_PUBLIC_MAINNET_MNEE_ADDRESS=0x8ccedbAe4916b79da7F3F612EfB2EB93A2bFD6cF
NEXT_PUBLIC_SEPOLIA_MNEE_ADDRESS=0x9CAF26bBFe63269FAF5C425f268fF81299dD9A74

# RPC URLs (Use your production Alchemy/Infura endpoints)
NEXT_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
